generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////
// ENUMS
//////////////////////////

enum ProjectStatus {
  DRAFT
  FOR_REVIEW
  FOR_APPROVAL
  ACTIVE
  INACTIVE
  ARCHIVED
  REJECTED
  NEEDS_REVISION
}

enum ApprovalLevel {
  BU_HEAD
  OP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

//////////////////////////
// USER + RBAC
//////////////////////////

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  roleId       String
  refreshToken String?
  isActive     Boolean @default(true)

  // 🔥 NEW: Department & Approver assignment
  departmentId String?
  approverId   String?

  role Role @relation(fields: [roleId], references: [id])

  projects        Project[] @relation("ProjectOwner")
  createdSubtasks Subtask[] @relation("SubtaskCreator")

  assignedSubtasks SubtaskAssignee[]
  assignedTasks    TaskAssignee[]

  comments    Comment[]
  attachments Attachment[]
  activities  ActivityLog[]

  // 🔥 ORG CHART: Manager-Member Relations (many-to-many)
  managers UserHierarchy[] @relation("UserMembers")
  members  UserHierarchy[] @relation("UserManagers")

  // 🔥 PROJECT: Project membership
  projectMembers ProjectMember[]

  progressLogs      ProgressLog[]
  dailyReports      DailyReport[]
  weeklyReports     WeeklyReport[]
  dailyReports_recv DailyReportReceiver[]
  weeklyReports_recv WeeklyReportReceiver[]

  // 🔥 NEW: Approvals & Notifications
  approvals      ProjectApproval[]
  approvalAuditLogs ApprovalAuditLog[] @relation("ApprovedBy")
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  users           User[]
  rolePermissions RolePermission[]
}

model Module {
  id       String  @id @default(uuid())
  name     String  @unique
  path     String
  isActive Boolean @default(true)

  rolePermissions RolePermission[]
}

model Permission {
  id     String @id @default(uuid())
  action String @unique

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  moduleId     String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  module     Module     @relation(fields: [moduleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, moduleId, permissionId])
}

//////////////////////////
// PROJECT MEMBER ROLES
//////////////////////////

model ProjectMember {
  id        String @id @default(uuid())
  projectId String
  userId    String
  role      String  // "OWNER", "SUB_OWNER", "MEMBER"

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

//////////////////////////
// ORG CHART HIERARCHY
//////////////////////////

model UserHierarchy {
  id       String @id @default(uuid())
  managerId String
  memberId String

  manager User @relation("UserMembers", fields: [managerId], references: [id])
  member  User @relation("UserManagers", fields: [memberId], references: [id])

  createdAt DateTime @default(now())

  @@unique([managerId, memberId])
  @@index([managerId])
  @@index([memberId])
}

//////////////////////////
// PROJECT
//////////////////////////

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  location     Json?
  businessUnit String?
  entity       String?

  startDate       DateTime?
  expectedEndDate DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?

  totalBudget Float?
  priority    String?
  duration    Int?

  pin String?

  progress Float @default(0)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  // 🔥 NEW: Project Status & Versioning
  status           ProjectStatus @default(DRAFT)
  versionNumber    Int           @default(1)
  versionLabel     String?
  isActive         Boolean       @default(false)
  isLatestVersion  Boolean       @default(true)
  isLocked         Boolean       @default(false)
  requiresApproval Boolean       @default(true)

  // 🔥 ROOT PROJECT (groups all versions together)
  rootProjectId String?
  rootProject   Project?  @relation("RootProject", fields: [rootProjectId], references: [id])
  versions      Project[] @relation("RootProject")

  // 🔥 PARENT PROJECT (previous version)
  parentProjectId String?
  parentProject   Project?  @relation("ProjectVersion", fields: [parentProjectId], references: [id])
  children        Project[] @relation("ProjectVersion")

  scopes          Scope[]
  attachments     Attachment[]
  projectMembers  ProjectMember[]
  dailyReports    DailyReport[]
  weeklyReports   WeeklyReport[]
  timelines       ProjectTimeline[]

  // 🔥 NEW: Approvals
  approvals        ProjectApproval[]
  approvalAuditLogs ApprovalAuditLog[] @relation("ApprovalAudit")

  // 🔥 NEW: Approval Flow Configuration
  approvalFlowId  String?
  approvalFlow    ApprovalFlow?  @relation(fields: [approvalFlowId], references: [id])
  approvalEnabled Boolean        @default(true)  // Can disable per project

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([isActive])
  @@index([pin])
  @@index([rootProjectId])
  @@index([parentProjectId])
  @@index([approvalFlowId])
}

//////////////////////////
// SCOPE (formerly Category)
//////////////////////////

model Scope {
  id          String  @id @default(uuid())
  name        String
  description String?
  order       Int     @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  budgetAllocated Float?
  budgetPercent   Float?

  progress Float @default(0)

  tasks Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId])
}

//////////////////////////
// TASK
//////////////////////////

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  order       Int     @default(0)

  scopeId String
  scope   Scope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  budgetAllocated Float?
  budgetPercent   Float?

  progress Float @default(0)

  assignees TaskAssignee[]
  subtasks  Subtask[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([scopeId])
}

//////////////////////////
// SUBTASK
//////////////////////////

model Subtask {
  id          String  @id @default(uuid())
  title       String
  description String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  order    Int
  priority String?

  status Int @default(0)

  projectedStartDate DateTime?
  projectedEndDate   DateTime?

  actualStartDate DateTime?
  actualEndDate   DateTime?

  budgetAllocated Float?
  budgetPercent   Float?

  progress Float @default(0)

  remarks String?

  createdBy String
  creator   User   @relation("SubtaskCreator", fields: [createdBy], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  checklists  Checklist[]
  assignees   SubtaskAssignee[]
  comments    Comment[]
  attachments Attachment[]
  activities  ActivityLog[]     @relation("SubtaskActivity")

  progressLogs ProgressLog[]

  @@index([taskId])
}

//////////////////////////
// APPROVAL FLOW SYSTEM
//////////////////////////

model ApprovalFlow {
  id          String  @id @default(uuid())
  name        String  @unique  // "BU_HEAD → OP", "Director → BU_HEAD → OP"
  description String?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)

  steps   ApprovalStep[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
  @@index([isActive])
}

model ApprovalStep {
  id    String @id @default(uuid())
  flowId String

  order Int
  role  String  // "BU_HEAD", "OP", "DIRECTOR", "FINANCE", etc.

  // Control how approval works at this step
  requiresAll Int @default(1)  // 0 = Any one approver, 1 = All approvers with role must approve
  canReject   Boolean @default(true)  // Can this step reject?

  flow ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([flowId, order])
  @@index([flowId])
}

//////////////////////////
// PROGRESS LOG
//////////////////////////

model ProgressLog {
  id        String  @id @default(uuid())
  subtaskId String
  userId    String?

  date              DateTime
  dailyPercent      Float
  cumulativePercent Float

  remarks   String?
  photoUrl  String?
  latitude  Float?
  longitude Float?

  location      String?
  dayNumber     Int?
  attachmentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtask Subtask @relation(fields: [subtaskId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([subtaskId, date])
}

//////////////////////////
// CHECKLIST
//////////////////////////

model Checklist {
  id          String  @id @default(uuid())
  title       String
  isCompleted Boolean @default(false)
  order       Int

  subtaskId String
  subtask   Subtask @relation(fields: [subtaskId], references: [id])
}

//////////////////////////
// ASSIGNEE
//////////////////////////

model SubtaskAssignee {
  subtaskId String
  userId    String

  subtask Subtask @relation(fields: [subtaskId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([subtaskId, userId])
}

//////////////////////////
// COMMENT
//////////////////////////

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  subtaskId String
  userId    String

  subtask Subtask @relation(fields: [subtaskId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

//////////////////////////
// ATTACHMENT
//////////////////////////

model Attachment {
  id        String   @id @default(uuid())
  fileUrl   String
  fileName  String
  createdAt DateTime @default(now())

  subtaskId  String?
  projectId  String?
  uploadedBy String

  subtask Subtask? @relation(fields: [subtaskId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [uploadedBy], references: [id])
}

//////////////////////////
// ACTIVITY LOG
//////////////////////////

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  userId    String
  subtaskId String?

  user    User     @relation(fields: [userId], references: [id])
  subtask Subtask? @relation("SubtaskActivity", fields: [subtaskId], references: [id])

  @@index([entityType, entityId])
}

//////////////////////////
// REPORTING
//////////////////////////

model DailyReport {
  id        String @id @default(uuid())
  userId    String
  projectId String

  dayNumber Int
  date      DateTime
  location  String
  remarks   String?

  attachments String[]

  createdAt DateTime @default(now())

  user      User                 @relation(fields: [userId], references: [id])
  project   Project              @relation(fields: [projectId], references: [id])
  receivers DailyReportReceiver[]
}

model DailyReportReceiver {
  reportId String
  userId   String
  read     Boolean @default(false)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])

  @@id([reportId, userId])
}

model WeeklyReport {
  id     String @id @default(uuid())
  userId String

  projectId String?

  title    String
  dateFrom DateTime
  dateTo   DateTime

  remarks     String?
  attachments String[]

  createdAt DateTime @default(now())

  user      User                   @relation(fields: [userId], references: [id])
  project   Project?               @relation(fields: [projectId], references: [id])
  receivers WeeklyReportReceiver[]

  @@index([projectId])
}

model WeeklyReportReceiver {
  reportId String
  userId   String
  read     Boolean @default(false)

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id])

  @@id([reportId, userId])
}

//////////////////////////
// APPROVAL SYSTEM
//////////////////////////

model ProjectApproval {
  id        String @id @default(uuid())
  projectId String

  level   ApprovalLevel
  order   Int                @default(0)
  isFinal Boolean            @default(false)
  status  ApprovalStatus     @default(PENDING)

  approverId String
  approver   User            @relation(fields: [approverId], references: [id])

  remarks String?
  actedAt DateTime?

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([approverId])
  @@index([status])
  @@index([level])
}

//////////////////////////
// NOTIFICATIONS
//////////////////////////

model Notification {
  id     String @id @default(uuid())
  userId String

  type    String
  message String

  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

//////////////////////////
// APPROVAL AUDIT LOG
//////////////////////////

model ApprovalAuditLog {
  id              String  @id @default(uuid())
  projectId       String
  approverId      String
  level           ApprovalLevel
  action          String // "SUBMITTED", "APPROVED", "REJECTED", "RESUBMITTED"
  previousStatus  ProjectStatus?
  newStatus       ProjectStatus?
  remarks         String?
  
  project         Project @relation("ApprovalAudit", fields: [projectId], references: [id], onDelete: Cascade)
  approver        User    @relation("ApprovedBy", fields: [approverId], references: [id])

  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([approverId])
  @@index([createdAt])
}

//////////////////////////
// SYSTEM SETTINGS
//////////////////////////

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////
// S-CURVE SNAPSHOT
//////////////////////////

model ProjectTimeline {
  id        String @id @default(uuid())
  projectId String

  date DateTime

  planned Float
  actual  Float

  variance  Float
  daysAhead Float

  project Project @relation(fields: [projectId], references: [id])
}
