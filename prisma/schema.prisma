generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String                    @id @default(uuid())
  name                         String
  firstName                    String?
  lastName                     String?
  company                      String?
  email                        String                    @unique
  password                     String
  roleId                       String
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  refreshToken                 String?
  isActive                     Boolean                   @default(true)
  departmentId                 String?
  businessUnitId               String?
  position                     String?
  activities                   ActivityLog[]
  approvalAuditLogs            ApprovalAuditLog[]        @relation("ApprovedBy")
  approvalStepUsers            ApprovalStepUser[]        @relation("ApprovalStepUsers")
  attachments                  Attachment[]
  comments                     Comment[]
  dailyReports                 DailyReport[]
  dailyReports_recv            DailyReportReceiver[]
  notifications                Notification[]
  progressLogs                 ProgressLog[]
  projects                     Project[]                 @relation("ProjectOwner")
  approvals                    ProjectApproval[]
  projectMembers               ProjectMember[]
  createdSubtasks              Subtask[]                 @relation("SubtaskCreator")
  assignedSubtasks             SubtaskAssignee[]
  assignedTasks                TaskAssignee[]
  role                         Role                      @relation(fields: [roleId], references: [id])
  businessUnit                 BusinessUnit?             @relation(fields: [businessUnitId], references: [id])
  headedBusinessUnits          BusinessUnit[]            @relation("BusinessUnitHead")
  assistantHeadedBusinessUnits BusinessUnit[]            @relation("BusinessUnitAssistantHead")
  managers                     UserHierarchy[]           @relation("UserMembers")
  members                      UserHierarchy[]           @relation("UserManagers")
  dashboardNotes               DashboardNote[]
  incidentReports              IncidentReport[]          @relation("IncidentReporter")
  resolvedIncidents            IncidentReport[]          @relation("IncidentResolver")
  cancelledIncidents           IncidentReport[]          @relation("IncidentCanceller")
  incidentAttachments          IncidentAttachment[]
  updatedSubtaskKpiConfigs     ProjectSubtaskKpiConfig[]
  createdDashboardKpis         DashboardKpi[]            @relation("DashboardKpiCreatedBy")
  updatedDashboardKpis         DashboardKpi[]            @relation("DashboardKpiUpdatedBy")
  weeklyReports                WeeklyReport[]
  weeklyReports_recv           WeeklyReportReceiver[]
  reviewedSsoRegistrations     SsoRegistration[]         @relation("SsoRegistrationReviewedBy")
  ssoRegistrationAuditChanges  SsoRegistrationAudit[]
}

model Role {
  id               String            @id @default(uuid())
  name             String            @unique
  isActive         Boolean           @default(true)
  rolePermissions  RolePermission[]
  users            User[]
  ssoRegistrations SsoRegistration[]
}

model Module {
  id              String           @id @default(uuid())
  name            String           @unique
  path            String
  isActive        Boolean          @default(true)
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  action          String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  moduleId     String
  permissionId String
  module       Module     @relation(fields: [moduleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, moduleId, permissionId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model UserHierarchy {
  id        String   @id @default(uuid())
  managerId String
  memberId  String
  createdAt DateTime @default(now())
  manager   User     @relation("UserMembers", fields: [managerId], references: [id])
  member    User     @relation("UserManagers", fields: [memberId], references: [id])

  @@unique([managerId, memberId])
  @@index([managerId])
  @@index([memberId])
}

model Project {
  id                 String                     @id @default(uuid())
  name               String
  description        String?
  ownerId            String
  createdAt          DateTime                   @default(now())
  progress           Decimal                    @default(0) @db.Decimal(5, 2)
  actualEndDate      DateTime?
  actualStartDate    DateTime?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  deletedAt          DateTime?
  duration           Int?
  expectedEndDate    DateTime?
  pin                String?
  priority           String?
  startDate          DateTime?
  totalBudget        Float?
  updatedAt          DateTime                   @updatedAt
  businessUnit       String?
  entity             String?
  location           Json?
  isActive           Boolean                    @default(false)
  isLatestVersion    Boolean                    @default(true)
  isLocked           Boolean                    @default(false)
  parentProjectId    String?
  requiresApproval   Boolean                    @default(true)
  rootProjectId      String?
  status             ProjectStatus              @default(DRAFT)
  versionLabel       String?
  versionNumber      Int                        @default(1)
  approvalFlowId     String?
  approvalEnabled    Boolean                    @default(true)
  monday             Boolean                    @default(true)
  tuesday            Boolean                    @default(true)
  wednesday          Boolean                    @default(true)
  thursday           Boolean                    @default(true)
  friday             Boolean                    @default(true)
  saturday           Boolean                    @default(false)
  sunday             Boolean                    @default(false)
  includeHolidays    Boolean                    @default(true)
  approvalAuditLogs  ApprovalAuditLog[]         @relation("ApprovalAudit")
  attachments        Attachment[]
  dailyReports       DailyReport[]
  approvalFlow       ApprovalFlow?              @relation(fields: [approvalFlowId], references: [id])
  owner              User                       @relation("ProjectOwner", fields: [ownerId], references: [id])
  parentProject      Project?                   @relation("ProjectVersion", fields: [parentProjectId], references: [id])
  children           Project[]                  @relation("ProjectVersion")
  rootProject        Project?                   @relation("RootProject", fields: [rootProjectId], references: [id])
  versions           Project[]                  @relation("RootProject")
  approvals          ProjectApproval[]
  projectMembers     ProjectMember[]
  dashboardKpis      DashboardKpi[]
  incidentReports    IncidentReport[]
  subtaskKpiConfig   ProjectSubtaskKpiConfig?
  dashboardSnapshots ProjectDashboardSnapshot[]
  timelines          ProjectTimeline[]
  scopes             Scope[]
  weeklyReports      WeeklyReport[]
  cpmDependencies    CpmDependency[]

  @@index([status])
  @@index([isActive])
  @@index([pin])
  @@index([rootProjectId])
  @@index([parentProjectId])
  @@index([approvalFlowId])
}

model Scope {
  id                 String            @id @default(uuid())
  name               String
  description        String?
  order              Int               @default(0)
  projectId          String
  budgetAllocated    Float?
  budgetPercent      Float?
  progress           Decimal           @default(0) @db.Decimal(5, 2)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  sourceType         String?
  scopeMaintenanceId String?
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopeMaintenance   ScopeMaintenance? @relation(fields: [scopeMaintenanceId], references: [id], onDelete: SetNull)
  tasks              Task[]
  incidentReports    IncidentReport[]
  kpiTargets         KpiTarget[]

  @@index([projectId])
  @@index([scopeMaintenanceId])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model Task {
  id                String           @id @default(uuid())
  title             String
  description       String?
  createdAt         DateTime         @default(now())
  progress          Decimal          @default(0) @db.Decimal(5, 2)
  budgetAllocated   Float?
  budgetPercent     Float?
  deletedAt         DateTime?
  updatedAt         DateTime         @updatedAt
  order             Int              @default(0)
  scopeId           String
  sourceType        String?
  taskMaintenanceId String?
  subtasks          Subtask[]
  scope             Scope            @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  taskMaintenance   TaskMaintenance? @relation(fields: [taskMaintenanceId], references: [id], onDelete: SetNull)
  assignees         TaskAssignee[]
  incidentReports   IncidentReport[]
  kpiTargets        KpiTarget[]

  @@index([scopeId])
  @@index([taskMaintenanceId])
}

model Subtask {
  id                   String              @id @default(uuid())
  title                String
  description          String?
  taskId               String
  order                Int
  priority             String?
  createdBy            String
  createdAt            DateTime            @default(now())
  progress             Decimal             @default(0) @db.Decimal(5, 2)
  actualEndDate        DateTime?
  actualStartDate      DateTime?
  budgetAllocated      Float?
  budgetPercent        Float?
  deletedAt            DateTime?
  projectedEndDate     DateTime?
  projectedStartDate   DateTime?
  remarks              String?
  updatedAt            DateTime            @updatedAt
  status               Int                 @default(0)
  sourceType           String?
  subtaskMaintenanceId String?
  activities           ActivityLog[]       @relation("SubtaskActivity")
  attachments          Attachment[]
  checklists           Checklist[]
  comments             Comment[]
  progressLogs         ProgressLog[]
  creator              User                @relation("SubtaskCreator", fields: [createdBy], references: [id])
  task                 Task                @relation(fields: [taskId], references: [id])
  subtaskMaintenance   SubtaskMaintenance? @relation(fields: [subtaskMaintenanceId], references: [id], onDelete: SetNull)
  assignees            SubtaskAssignee[]
  incidentReports      IncidentReport[]
  kpiTargets           KpiTarget[]
  cpmPredecessorLinks  CpmDependency[]     @relation("CpmPredecessor")
  cpmSuccessorLinks    CpmDependency[]     @relation("CpmSuccessor")

  @@index([taskId])
  @@index([subtaskMaintenanceId])
}

model CpmDependency {
  id                   String   @id @default(uuid())
  projectId            String
  predecessorSubtaskId String
  successorSubtaskId   String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessorSubtask   Subtask  @relation("CpmPredecessor", fields: [predecessorSubtaskId], references: [id], onDelete: Cascade)
  successorSubtask     Subtask  @relation("CpmSuccessor", fields: [successorSubtaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorSubtaskId, successorSubtaskId])
  @@index([projectId])
  @@index([predecessorSubtaskId])
  @@index([successorSubtaskId])
}

model ScopeMaintenance {
  id          String                 @id @default(uuid())
  code        String                 @unique
  name        String
  description String?
  order       Int                    @default(0)
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  taskLinks   ScopeMaintenanceTask[]
  scopes      Scope[]

  @@index([isActive])
  @@index([order])
}

model TaskMaintenance {
  id           String                   @id @default(uuid())
  code         String                   @unique
  name         String
  description  String?
  order        Int                      @default(0)
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  scopeLinks   ScopeMaintenanceTask[]
  subtaskLinks TaskMaintenanceSubtask[]
  tasks        Task[]

  @@index([isActive])
  @@index([order])
}

model SubtaskMaintenance {
  id          String                   @id @default(uuid())
  code        String                   @unique
  name        String
  description String?
  order       Int                      @default(0)
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  taskLinks   TaskMaintenanceSubtask[]
  subtasks    Subtask[]

  @@index([isActive])
  @@index([order])
}

model ScopeMaintenanceTask {
  scopeMaintenanceId String
  taskMaintenanceId  String
  order              Int              @default(0)
  scopeMaintenance   ScopeMaintenance @relation(fields: [scopeMaintenanceId], references: [id], onDelete: Cascade)
  taskMaintenance    TaskMaintenance  @relation(fields: [taskMaintenanceId], references: [id], onDelete: Cascade)

  @@id([scopeMaintenanceId, taskMaintenanceId])
  @@index([taskMaintenanceId])
}

model TaskMaintenanceSubtask {
  taskMaintenanceId    String
  subtaskMaintenanceId String
  order                Int                @default(0)
  taskMaintenance      TaskMaintenance    @relation(fields: [taskMaintenanceId], references: [id], onDelete: Cascade)
  subtaskMaintenance   SubtaskMaintenance @relation(fields: [subtaskMaintenanceId], references: [id], onDelete: Cascade)

  @@id([taskMaintenanceId, subtaskMaintenanceId])
  @@index([subtaskMaintenanceId])
}

model ApprovalFlow {
  id               String         @id @default(uuid())
  name             String         @unique
  description      String?
  isDefault        Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  executionMode    String         @default("SEQUENTIAL")
  selfApprovalMode String         @default("THROUGH_HIGHEST_STEP")
  steps            ApprovalStep[]
  projects         Project[]

  @@index([isDefault])
  @@index([isActive])
}

model ApprovalStep {
  id                String             @id @default(uuid())
  flowId            String
  order             Int
  role              String?
  stepExecutionMode String             @default("PARALLEL")
  requiresAll       Int                @default(1)
  canReject         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  useSpecificUsers  Boolean            @default(false)
  approverSource    String             @default("ROLE")
  flow              ApprovalFlow       @relation(fields: [flowId], references: [id], onDelete: Cascade)
  assignedUsers     ApprovalStepUser[]

  @@unique([flowId, order])
  @@index([flowId])
}

model ApprovalStepUser {
  id        String       @id @default(uuid())
  stepId    String
  userId    String
  createdAt DateTime     @default(now())
  step      ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user      User         @relation("ApprovalStepUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stepId, userId])
  @@index([stepId])
  @@index([userId])
}

model ProgressLog {
  id                String                  @id @default(uuid())
  subtaskId         String
  date              DateTime
  dailyPercent      Decimal                 @db.Decimal(5, 2)
  cumulativePercent Decimal                 @db.Decimal(5, 2)
  latitude          Float?
  longitude         Float?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  photoUrl          String?
  remarks           String?
  attachmentUrl     String?
  dayNumber         Int?
  location          String?
  userId            String?
  subtask           Subtask                 @relation(fields: [subtaskId], references: [id])
  user              User?                   @relation(fields: [userId], references: [id])
  attachments       ProgressLogAttachment[]

  @@unique([subtaskId, date, userId])
}

model ProgressLogAttachment {
  id            String      @id @default(uuid())
  progressLogId String
  url           String
  name          String
  mimeType      String?
  size          Int?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  progressLog   ProgressLog @relation(fields: [progressLogId], references: [id], onDelete: Cascade)
}

model Checklist {
  id          String  @id @default(uuid())
  title       String
  isCompleted Boolean @default(false)
  order       Int
  subtaskId   String
  subtask     Subtask @relation(fields: [subtaskId], references: [id])
}

model SubtaskAssignee {
  subtaskId String
  userId    String
  subtask   Subtask @relation(fields: [subtaskId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([subtaskId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  subtaskId String
  userId    String
  subtask   Subtask  @relation(fields: [subtaskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Attachment {
  id             String        @id @default(uuid())
  fileUrl        String
  fileName       String
  mimeType       String?
  size           Int?
  createdAt      DateTime      @default(now())
  subtaskId      String?
  uploadedBy     String
  projectId      String?
  dailyReportId  String?
  weeklyReportId String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subtask        Subtask?      @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  dailyReport    DailyReport?  @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  weeklyReport   WeeklyReport? @relation(fields: [weeklyReportId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [uploadedBy], references: [id])
}

model IncidentReport {
  id                 String               @id @default(uuid())
  incidentNumber     String               @unique
  projectId          String
  reportedById       String
  title              String
  description        String
  status             IncidentStatus       @default(PENDING)
  severity           IncidentSeverity     @default(MEDIUM)
  dateRaised         DateTime             @default(now())
  dateAddressed      DateTime?
  remarks            String?
  scopeId            String?
  taskId             String?
  subtaskId          String?
  resolvedById       String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy         User                 @relation("IncidentReporter", fields: [reportedById], references: [id])
  resolvedBy         User?                @relation("IncidentResolver", fields: [resolvedById], references: [id])
  cancelledBy        User?                @relation("IncidentCanceller", fields: [cancelledById], references: [id])
  scope              Scope?               @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  task               Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subtask            Subtask?             @relation(fields: [subtaskId], references: [id], onDelete: SetNull)
  attachments        IncidentAttachment[]

  @@index([projectId])
  @@index([reportedById])
  @@index([status])
  @@index([severity])
  @@index([dateRaised])
  @@index([scopeId])
  @@index([taskId])
  @@index([subtaskId])
}

model IncidentAttachment {
  id         String         @id @default(uuid())
  incidentId String
  uploadedBy String
  fileUrl    String
  fileName   String
  mimeType   String?
  size       Int?
  createdAt  DateTime       @default(now())
  incident   IncidentReport @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [uploadedBy], references: [id])

  @@index([incidentId])
  @@index([uploadedBy])
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  userId     String
  subtaskId  String?
  subtask    Subtask? @relation("SubtaskActivity", fields: [subtaskId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model DailyReport {
  id            String                @id @default(uuid())
  userId        String
  projectId     String
  dayNumber     Int
  date          DateTime
  location      String
  remarks       String?
  attachments   String[]
  createdAt     DateTime              @default(now())
  project       Project               @relation(fields: [projectId], references: [id])
  user          User                  @relation(fields: [userId], references: [id])
  receivers     DailyReportReceiver[]
  uploadedFiles Attachment[]
}

model DailyReportReceiver {
  reportId String
  userId   String
  read     Boolean     @default(false)
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])

  @@id([reportId, userId])
}

model WeeklyReport {
  id            String                 @id @default(uuid())
  userId        String
  title         String
  dateFrom      DateTime
  dateTo        DateTime
  remarks       String?
  attachments   String[]
  createdAt     DateTime               @default(now())
  projectId     String?
  project       Project?               @relation(fields: [projectId], references: [id])
  user          User                   @relation(fields: [userId], references: [id])
  receivers     WeeklyReportReceiver[]
  uploadedFiles Attachment[]

  @@index([projectId])
}

model WeeklyReportReceiver {
  reportId String
  userId   String
  read     Boolean      @default(false)
  report   WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])

  @@id([reportId, userId])
}

model ProjectApproval {
  id         String         @id @default(uuid())
  projectId  String
  level      String
  order      Int            @default(0)
  isFinal    Boolean        @default(false)
  status     ApprovalStatus @default(PENDING)
  approverId String
  remarks    String?
  actedAt    DateTime?
  createdAt  DateTime       @default(now())
  approver   User           @relation(fields: [approverId], references: [id])
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([approverId])
  @@index([status])
  @@index([level])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model ApprovalAuditLog {
  id             String         @id @default(uuid())
  projectId      String
  approverId     String
  level          String
  action         String
  previousStatus ProjectStatus?
  newStatus      ProjectStatus?
  remarks        String?
  createdAt      DateTime       @default(now())
  approver       User           @relation("ApprovedBy", fields: [approverId], references: [id])
  project        Project        @relation("ApprovalAudit", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([approverId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectTimeline {
  id        String   @id @default(uuid())
  projectId String
  date      DateTime
  planned   Float
  actual    Float
  variance  Float
  daysAhead Float
  project   Project  @relation(fields: [projectId], references: [id])
}

model DashboardNote {
  id        String              @id @default(uuid())
  userId    String
  title     String?
  content   String?
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     DashboardNoteItem[]

  @@index([userId])
}

model DashboardNoteItem {
  id        String        @id @default(uuid())
  noteId    String
  text      String
  isDone    Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  note      DashboardNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model DashboardKpi {
  id          String      @id @default(uuid())
  name        String
  description String?
  projectId   String
  createdById String
  updatedById String?
  chartTypes  Json        @default("[\"DONUT\"]")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("DashboardKpiCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?       @relation("DashboardKpiUpdatedBy", fields: [updatedById], references: [id])
  targets     KpiTarget[]

  @@index([projectId])
  @@index([createdById])
  @@index([updatedById])
}

model KpiTarget {
  id               String       @id @default(uuid())
  kpiId            String
  scopeId          String?
  taskId           String?
  subtaskId        String?
  field            KpiField     @default(PROGRESS)
  unit             String       @default("%")
  criticalBelow    Decimal      @default(-15) @db.Decimal(5, 2)
  healthyAtOrAbove Decimal      @default(-5) @db.Decimal(5, 2)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  kpi              DashboardKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  scope            Scope?       @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  task             Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subtask          Subtask?     @relation(fields: [subtaskId], references: [id], onDelete: SetNull)

  @@index([kpiId])
  @@index([scopeId])
  @@index([taskId])
  @@index([subtaskId])
}

model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Region {
  id        String     @id @default(uuid())
  regCode   String     @unique
  regName   String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  provinces Province[]

  @@index([regCode])
}

model Province {
  id        String   @id @default(uuid())
  provCode  String   @unique
  provName  String
  regCode   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
  region    Region   @relation(fields: [regCode], references: [regCode], onDelete: Cascade)

  @@index([regCode])
  @@index([provCode])
}

model City {
  id        String     @id @default(uuid())
  cityCode  String     @unique
  cityName  String
  provCode  String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  barangays Barangay[]
  province  Province   @relation(fields: [provCode], references: [provCode], onDelete: Cascade)

  @@index([provCode])
  @@index([cityCode])
}

model Barangay {
  id        String   @id @default(uuid())
  brgyCode  String   @unique
  brgyName  String
  cityCode  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  city      City     @relation(fields: [cityCode], references: [cityCode], onDelete: Cascade)

  @@index([cityCode])
  @@index([brgyCode])
}

model BusinessUnit {
  id                  String            @id @default(uuid())
  code                String            @unique
  name                String
  entity              String
  buHead              String?
  buHeadUserId        String?
  buHeadUser          User?             @relation("BusinessUnitHead", fields: [buHeadUserId], references: [id], onDelete: SetNull)
  assistantHead       String?
  assistantHeadUserId String?
  assistantHeadUser   User?             @relation("BusinessUnitAssistantHead", fields: [assistantHeadUserId], references: [id], onDelete: SetNull)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  ssoRegistrations    SsoRegistration[]
  users               User[]

  @@index([code])
  @@index([entity])
  @@index([buHeadUserId])
  @@index([assistantHeadUserId])
}

model SsoRegistration {
  id              String                 @id @default(uuid())
  referenceNo     String                 @unique
  email           String                 @unique
  fullName        String
  firstName       String?
  lastName        String?
  company         String?
  provider        String                 @default("MICROSOFT")
  providerOid     String?
  mobileNo        String?
  requestedRoleId String?
  businessUnitId  String?
  departmentId    String?
  position        String?
  remarks         String?
  status          SsoRegistrationStatus  @default(PENDING)
  rejectReason    String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  requestedRole   Role?                  @relation(fields: [requestedRoleId], references: [id])
  businessUnit    BusinessUnit?          @relation(fields: [businessUnitId], references: [id])
  reviewedBy      User?                  @relation("SsoRegistrationReviewedBy", fields: [reviewedById], references: [id])
  audits          SsoRegistrationAudit[]

  @@index([status])
  @@index([createdAt])
}

model SsoRegistrationAudit {
  id             String                 @id @default(uuid())
  registrationId String
  action         SsoRegistrationAction
  fromStatus     SsoRegistrationStatus?
  toStatus       SsoRegistrationStatus?
  reason         String?
  snapshot       Json?
  changedById    String?
  createdAt      DateTime               @default(now())
  registration   SsoRegistration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  changedBy      User?                  @relation(fields: [changedById], references: [id])

  @@index([registrationId])
  @@index([createdAt])
}

enum ProjectStatus {
  DRAFT
  FOR_REVIEW
  FOR_APPROVAL
  ACTIVE
  COMPLETED
  CANCELLED
  INACTIVE
  REJECTED
  NEEDS_REVISION
  ARCHIVED
}

enum ApprovalLevel {
  BU_HEAD
  OP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum KpiSourceType {
  PROJECT
  SCOPE
  TASK
  SUBTASK
}

enum KpiField {
  PROGRESS
}

enum KpiStatus {
  CRITICAL
  ONFLOW
  HEALTHY
  UNCLASSIFIED
}

enum KpiValueOperator {
  LT
  LTE
  EQ
  GTE
  GT
  BETWEEN
}

model ProjectSubtaskKpiConfig {
  id               String   @id @default(uuid())
  projectId        String   @unique
  criticalBelow    Float    @default(-15)
  healthyAtOrAbove Float    @default(-5)
  updatedById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy        User     @relation(fields: [updatedById], references: [id])

  @@index([updatedById])
}

model ProjectDashboardSnapshot {
  id              String        @id @default(uuid())
  projectId       String
  snapshotDate    DateTime      @db.Date
  critical        Int           @default(0)
  onflow          Int           @default(0)
  healthy         Int           @default(0)
  unclassified    Int           @default(0)
  totalKpis       Int           @default(0)
  incidentReports Int           @default(0)
  projectProgress Float         @default(0)
  projectStatus   ProjectStatus
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, snapshotDate])
  @@index([snapshotDate])
  @@index([projectStatus])
}

enum IncidentStatus {
  PENDING
  RESOLVED
  CANCELLED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SsoRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SsoRegistrationAction {
  CREATED
  RESUBMITTED
  APPROVED
  REJECTED
  UPDATED
}
