generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////
// USER + RBAC
//////////////////////////

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  roleId       String
  refreshToken String?
  isActive     Boolean @default(true)

  role Role @relation(fields: [roleId], references: [id])

  managedProjects Project[] @relation("ProjectManager")
  projects         Project[] @relation("ProjectOwner")
  createdSubtasks  Subtask[] @relation("SubtaskCreator")
  assignedSubtasks SubtaskAssignee[]
  assignedTasks TaskAssignee[]
  comments         Comment[]
  attachments      Attachment[]
  activities       ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  users           User[]
  rolePermissions RolePermission[]
}

model Module {
  id       String  @id @default(uuid())
  name     String  @unique
  path     String
  isActive Boolean @default(true)

  rolePermissions RolePermission[]
}

model Permission {
  id     String @id @default(uuid())
  action String @unique

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  moduleId     String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  module     Module     @relation(fields: [moduleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, moduleId, permissionId])
}

//////////////////////////
// PROJECT
//////////////////////////

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  location Json?
  businessUnit String?
  entity String?
  managerId  String?
  manager    User? @relation("ProjectManager", fields: [managerId], references: [id])

  startDate       DateTime?
  expectedEndDate DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?

  totalBudget Float?
  priority    String?
  duration    Int?

  pin String? @unique

  progress Float @default(0)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  categories  Category[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

//////////////////////////
// CATEGORY
//////////////////////////

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  budgetAllocated Float?
  budgetPercent   Float?

  progress Float @default(0)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

//////////////////////////
// TASK
//////////////////////////

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  budgetAllocated Float?
  budgetPercent   Float?

  progress Float @default(0)

  assignees TaskAssignee[]

  subtasks Subtask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

//////////////////////////
// SUBTASK
//////////////////////////

model Subtask {
  id          String  @id @default(uuid())
  title       String
  description String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  order Int

  priority String?

  // 🔥 NEW STATUS SYSTEM
  status Int @default(0) // 0=Pending, 1=Ongoing, 2=Done

  // 📅 PROJECTED
  projectedStartDate DateTime?
  projectedEndDate   DateTime?

  // 📅 ACTUAL (AUTO)
  actualStartDate DateTime?
  actualEndDate   DateTime?

  // 💰 BUDGET
  budgetAllocated Float?
  budgetPercent   Float?

  // 📊 PROGRESS
  progress Float @default(0)

  remarks String?

  createdBy String
  creator   User @relation("SubtaskCreator", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  checklists  Checklist[]
  assignees   SubtaskAssignee[]
  comments    Comment[]
  attachments Attachment[]
  activities  ActivityLog[] @relation("SubtaskActivity")

  progressLogs ProgressLog[]

  @@index([taskId])
}

//////////////////////////
// PROGRESS LOG
//////////////////////////

model ProgressLog {
  id                String   @id @default(uuid())
  subtaskId         String
  date              DateTime

  dailyPercent      Float
  cumulativePercent Float

  remarks   String?
  photoUrl  String?
  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtask Subtask @relation(fields: [subtaskId], references: [id])

  @@unique([subtaskId, date])
}

//////////////////////////
// CHECKLIST
//////////////////////////

model Checklist {
  id          String  @id @default(uuid())
  title       String
  isCompleted Boolean @default(false)
  order       Int

  subtaskId String
  subtask   Subtask @relation(fields: [subtaskId], references: [id])
}

//////////////////////////
// ASSIGNEE
//////////////////////////

model SubtaskAssignee {
  subtaskId String
  userId    String

  subtask Subtask @relation(fields: [subtaskId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([subtaskId, userId])
}

//////////////////////////
// COMMENT
//////////////////////////

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  subtaskId String
  userId    String

  subtask Subtask @relation(fields: [subtaskId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

//////////////////////////
// ATTACHMENT
//////////////////////////

model Attachment {
  id        String   @id @default(uuid())
  fileUrl   String
  fileName  String
  createdAt DateTime @default(now())

  subtaskId  String?
  projectId  String?
  uploadedBy String

  subtask Subtask? @relation(fields: [subtaskId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [uploadedBy], references: [id])
}

//////////////////////////
// ACTIVITY LOG
//////////////////////////

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  userId    String
  subtaskId String?

  user    User     @relation(fields: [userId], references: [id])
  subtask Subtask? @relation("SubtaskActivity", fields: [subtaskId], references: [id])

  @@index([entityType, entityId])
}