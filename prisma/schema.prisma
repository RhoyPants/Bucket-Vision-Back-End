generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////
// USER + RBAC
//////////////////////////

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  roleId       String
  refreshToken String?
  isActive     Boolean @default(true)

  role Role @relation(fields: [roleId], references: [id])

  projects        Project[] @relation("ProjectOwner")
  createdSubtasks Subtask[] @relation("SubtaskCreator")

  assignedSubtasks SubtaskAssignee[]
  assignedTasks    TaskAssignee[]

  comments    Comment[]
  attachments Attachment[]
  activities  ActivityLog[]

  // 🔥 ORG CHART: Manager-Member Relations (many-to-many)
  managers UserHierarchy[] @relation("UserMembers")
  members  UserHierarchy[] @relation("UserManagers")

  // 🔥 PROJECT: Project membership
  projectMembers ProjectMember[]

  progressLogs      ProgressLog[]
  dailyReports      DailyReport[]
  weeklyReports     WeeklyReport[]
  dailyReports_recv DailyReportReceiver[]
  weeklyReports_recv WeeklyReportReceiver[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  users           User[]
  rolePermissions RolePermission[]
}

model Module {
  id       String  @id @default(uuid())
  name     String  @unique
  path     String
  isActive Boolean @default(true)

  rolePermissions RolePermission[]
}

model Permission {
  id     String @id @default(uuid())
  action String @unique

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  moduleId     String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  module     Module     @relation(fields: [moduleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, moduleId, permissionId])
}

//////////////////////////
// PROJECT MEMBER ROLES
//////////////////////////

model ProjectMember {
  id        String @id @default(uuid())
  projectId String
  userId    String
  role      String  // "OWNER", "SUB_OWNER", "MEMBER"

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

//////////////////////////
// ORG CHART HIERARCHY
//////////////////////////

model UserHierarchy {
  id       String @id @default(uuid())
  managerId String
  memberId String

  manager User @relation("UserMembers", fields: [managerId], references: [id])
  member  User @relation("UserManagers", fields: [memberId], references: [id])

  createdAt DateTime @default(now())

  @@unique([managerId, memberId])
  @@index([managerId])
  @@index([memberId])
}

//////////////////////////
// PROJECT
//////////////////////////

model Project {
  id          String  @id @default(uuid())
  name        String
  description String?

  location     Json?
  businessUnit String?
  entity       String?

  startDate       DateTime?
  expectedEndDate DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?

  totalBudget Float?
  priority    String?
  duration    Int?

  pin String? @unique

  progress Float @default(0)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id])

  categories  Category[]
  attachments Attachment[]

  // 🔥 NEW: Project Members (Owner, SubOwner, Members)
  projectMembers ProjectMember[]

  // 🔥 NEW
  dailyReports DailyReport[]
  timelines    ProjectTimeline[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

//////////////////////////
// CATEGORY
//////////////////////////

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?
  order       Int     @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  budgetAllocated Float?
  budgetPercent   Float?

  progress Float @default(0)

  tasks Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

//////////////////////////
// TASK
//////////////////////////

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model Task {
  id          String  @id @default(uuid())
  title       String
  description String?
  order       Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  budgetAllocated Float?
  budgetPercent   Float?

  progress Float @default(0)

  assignees TaskAssignee[]
  subtasks  Subtask[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

//////////////////////////
// SUBTASK
//////////////////////////

model Subtask {
  id          String  @id @default(uuid())
  title       String
  description String?

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  order    Int
  priority String?

  status Int @default(0)

  projectedStartDate DateTime?
  projectedEndDate   DateTime?

  actualStartDate DateTime?
  actualEndDate   DateTime?

  budgetAllocated Float?
  budgetPercent   Float?

  progress Float @default(0)

  remarks String?

  createdBy String
  creator   User   @relation("SubtaskCreator", fields: [createdBy], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  checklists  Checklist[]
  assignees   SubtaskAssignee[]
  comments    Comment[]
  attachments Attachment[]
  activities  ActivityLog[]     @relation("SubtaskActivity")

  progressLogs ProgressLog[]

  @@index([taskId])
}

//////////////////////////
// PROGRESS LOG
//////////////////////////

model ProgressLog {
  id        String  @id @default(uuid())
  subtaskId String
  userId    String?

  date              DateTime
  dailyPercent      Float
  cumulativePercent Float

  remarks   String?
  photoUrl  String?
  latitude  Float?
  longitude Float?

  location      String?
  dayNumber     Int?
  attachmentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtask Subtask @relation(fields: [subtaskId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([subtaskId, date])
}

//////////////////////////
// CHECKLIST
//////////////////////////

model Checklist {
  id          String  @id @default(uuid())
  title       String
  isCompleted Boolean @default(false)
  order       Int

  subtaskId String
  subtask   Subtask @relation(fields: [subtaskId], references: [id])
}

//////////////////////////
// ASSIGNEE
//////////////////////////

model SubtaskAssignee {
  subtaskId String
  userId    String

  subtask Subtask @relation(fields: [subtaskId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([subtaskId, userId])
}

//////////////////////////
// COMMENT
//////////////////////////

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  subtaskId String
  userId    String

  subtask Subtask @relation(fields: [subtaskId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

//////////////////////////
// ATTACHMENT
//////////////////////////

model Attachment {
  id        String   @id @default(uuid())
  fileUrl   String
  fileName  String
  createdAt DateTime @default(now())

  subtaskId  String?
  projectId  String?
  uploadedBy String

  subtask Subtask? @relation(fields: [subtaskId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [uploadedBy], references: [id])
}

//////////////////////////
// ACTIVITY LOG
//////////////////////////

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  userId    String
  subtaskId String?

  user    User     @relation(fields: [userId], references: [id])
  subtask Subtask? @relation("SubtaskActivity", fields: [subtaskId], references: [id])

  @@index([entityType, entityId])
}

//////////////////////////
// REPORTING
//////////////////////////

model DailyReport {
  id        String @id @default(uuid())
  userId    String
  projectId String

  dayNumber Int
  date      DateTime
  location  String
  remarks   String?

  attachments String[]

  createdAt DateTime @default(now())

  user      User                 @relation(fields: [userId], references: [id])
  project   Project              @relation(fields: [projectId], references: [id])
  receivers DailyReportReceiver[]
}

model DailyReportReceiver {
  reportId String
  userId   String
  read     Boolean @default(false)

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id])

  @@id([reportId, userId])
}

model WeeklyReport {
  id     String @id @default(uuid())
  userId String

  title    String
  dateFrom DateTime
  dateTo   DateTime

  remarks     String?
  attachments String[]

  createdAt DateTime @default(now())

  user      User                  @relation(fields: [userId], references: [id])
  receivers WeeklyReportReceiver[]
}

model WeeklyReportReceiver {
  reportId String
  userId   String
  read     Boolean @default(false)

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id])

  @@id([reportId, userId])
}

//////////////////////////
// S-CURVE SNAPSHOT
//////////////////////////

model ProjectTimeline {
  id        String @id @default(uuid())
  projectId String

  date DateTime

  planned Float
  actual  Float

  variance  Float
  daysAhead Float

  project Project @relation(fields: [projectId], references: [id])
}
