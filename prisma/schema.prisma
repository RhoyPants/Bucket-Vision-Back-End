generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                 @id @default(uuid())
  name               String
  email              String                 @unique
  password           String
  roleId             String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  refreshToken       String?
  isActive           Boolean                @default(true)
  approverId         String?
  departmentId       String?
  activities         ActivityLog[]
  approvalAuditLogs  ApprovalAuditLog[]     @relation("ApprovedBy")
  approvalStepUsers  ApprovalStepUser[]     @relation("ApprovalStepUsers")
  attachments        Attachment[]
  comments           Comment[]
  dailyReports       DailyReport[]
  dailyReports_recv  DailyReportReceiver[]
  notifications      Notification[]
  progressLogs       ProgressLog[]
  projects           Project[]              @relation("ProjectOwner")
  approvals          ProjectApproval[]
  projectMembers     ProjectMember[]
  createdSubtasks    Subtask[]              @relation("SubtaskCreator")
  assignedSubtasks   SubtaskAssignee[]
  assignedTasks      TaskAssignee[]
  role               Role                   @relation(fields: [roleId], references: [id])
  managers           UserHierarchy[]        @relation("UserMembers")
  members            UserHierarchy[]        @relation("UserManagers")
  weeklyReports      WeeklyReport[]
  weeklyReports_recv WeeklyReportReceiver[]
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  isActive        Boolean          @default(true)
  rolePermissions RolePermission[]
  users           User[]
}

model Module {
  id              String           @id @default(uuid())
  name            String           @unique
  path            String
  isActive        Boolean          @default(true)
  rolePermissions RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  action          String           @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  moduleId     String
  permissionId String
  module       Module     @relation(fields: [moduleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, moduleId, permissionId])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model UserHierarchy {
  id        String   @id @default(uuid())
  managerId String
  memberId  String
  createdAt DateTime @default(now())
  manager   User     @relation("UserMembers", fields: [managerId], references: [id])
  member    User     @relation("UserManagers", fields: [memberId], references: [id])

  @@unique([managerId, memberId])
  @@index([managerId])
  @@index([memberId])
}

model Project {
  id                String             @id @default(uuid())
  name              String
  description       String?
  ownerId           String
  createdAt         DateTime           @default(now())
  progress          Float              @default(0)
  actualEndDate     DateTime?
  actualStartDate   DateTime?
  deletedAt         DateTime?
  duration          Int?
  expectedEndDate   DateTime?
  pin               String?
  priority          String?
  startDate         DateTime?
  totalBudget       Float?
  updatedAt         DateTime           @updatedAt
  businessUnit      String?
  entity            String?
  location          Json?
  isActive          Boolean            @default(false)
  isLatestVersion   Boolean            @default(true)
  isLocked          Boolean            @default(false)
  parentProjectId   String?
  requiresApproval  Boolean            @default(true)
  rootProjectId     String?
  status            ProjectStatus      @default(DRAFT)
  versionLabel      String?
  versionNumber     Int                @default(1)
  approvalFlowId    String?
  approvalEnabled   Boolean            @default(true)
  monday            Boolean            @default(true)
  tuesday           Boolean            @default(true)
  wednesday         Boolean            @default(true)
  thursday          Boolean            @default(true)
  friday            Boolean            @default(true)
  saturday          Boolean            @default(false)
  sunday            Boolean            @default(false)
  includeHolidays   Boolean            @default(true)
  approvalAuditLogs ApprovalAuditLog[] @relation("ApprovalAudit")
  attachments       Attachment[]
  dailyReports      DailyReport[]
  approvalFlow      ApprovalFlow?      @relation(fields: [approvalFlowId], references: [id])
  owner             User               @relation("ProjectOwner", fields: [ownerId], references: [id])
  parentProject     Project?           @relation("ProjectVersion", fields: [parentProjectId], references: [id])
  children          Project[]          @relation("ProjectVersion")
  rootProject       Project?           @relation("RootProject", fields: [rootProjectId], references: [id])
  versions          Project[]          @relation("RootProject")
  approvals         ProjectApproval[]
  projectMembers    ProjectMember[]
  timelines         ProjectTimeline[]
  scopes            Scope[]
  weeklyReports     WeeklyReport[]

  @@index([status])
  @@index([isActive])
  @@index([pin])
  @@index([rootProjectId])
  @@index([parentProjectId])
  @@index([approvalFlowId])
}

model Scope {
  id              String    @id @default(uuid())
  name            String
  description     String?
  order           Int       @default(0)
  projectId       String
  budgetAllocated Float?
  budgetPercent   Float?
  progress        Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks           Task[]

  @@index([projectId])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model Task {
  id              String         @id @default(uuid())
  title           String
  description     String?
  createdAt       DateTime       @default(now())
  progress        Float          @default(0)
  budgetAllocated Float?
  budgetPercent   Float?
  deletedAt       DateTime?
  updatedAt       DateTime       @updatedAt
  order           Int            @default(0)
  scopeId         String
  subtasks        Subtask[]
  scope           Scope          @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  assignees       TaskAssignee[]

  @@index([scopeId])
}

model Subtask {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  taskId             String
  order              Int
  priority           String?
  createdBy          String
  createdAt          DateTime          @default(now())
  progress           Float             @default(0)
  actualEndDate      DateTime?
  actualStartDate    DateTime?
  budgetAllocated    Float?
  budgetPercent      Float?
  deletedAt          DateTime?
  projectedEndDate   DateTime?
  projectedStartDate DateTime?
  remarks            String?
  updatedAt          DateTime          @updatedAt
  status             Int               @default(0)
  activities         ActivityLog[]     @relation("SubtaskActivity")
  attachments        Attachment[]
  checklists         Checklist[]
  comments           Comment[]
  progressLogs       ProgressLog[]
  creator            User              @relation("SubtaskCreator", fields: [createdBy], references: [id])
  task               Task              @relation(fields: [taskId], references: [id])
  assignees          SubtaskAssignee[]

  @@index([taskId])
}

model ApprovalFlow {
  id            String         @id @default(uuid())
  name          String         @unique
  description   String?
  isDefault     Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  executionMode String         @default("SEQUENTIAL")
  steps         ApprovalStep[]
  projects      Project[]

  @@index([isDefault])
  @@index([isActive])
}

model ApprovalStep {
  id               String             @id @default(uuid())
  flowId           String
  order            Int
  role             String?
  requiresAll      Int                @default(1)
  canReject        Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  useSpecificUsers Boolean            @default(false)
  flow             ApprovalFlow       @relation(fields: [flowId], references: [id], onDelete: Cascade)
  assignedUsers    ApprovalStepUser[]

  @@unique([flowId, order])
  @@index([flowId])
}

model ApprovalStepUser {
  id        String       @id @default(uuid())
  stepId    String
  userId    String
  createdAt DateTime     @default(now())
  step      ApprovalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user      User         @relation("ApprovalStepUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stepId, userId])
  @@index([stepId])
  @@index([userId])
}

model ProgressLog {
  id                String   @id @default(uuid())
  subtaskId         String
  date              DateTime
  dailyPercent      Float
  cumulativePercent Float
  latitude          Float?
  longitude         Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  photoUrl          String?
  remarks           String?
  attachmentUrl     String?
  dayNumber         Int?
  location          String?
  userId            String?
  subtask           Subtask  @relation(fields: [subtaskId], references: [id])
  user              User?    @relation(fields: [userId], references: [id])

  @@unique([subtaskId, date])
}

model Checklist {
  id          String  @id @default(uuid())
  title       String
  isCompleted Boolean @default(false)
  order       Int
  subtaskId   String
  subtask     Subtask @relation(fields: [subtaskId], references: [id])
}

model SubtaskAssignee {
  subtaskId String
  userId    String
  subtask   Subtask @relation(fields: [subtaskId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([subtaskId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  subtaskId String
  userId    String
  subtask   Subtask  @relation(fields: [subtaskId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Attachment {
  id         String   @id @default(uuid())
  fileUrl    String
  fileName   String
  createdAt  DateTime @default(now())
  subtaskId  String?
  uploadedBy String
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  subtask    Subtask? @relation(fields: [subtaskId], references: [id])
  user       User     @relation(fields: [uploadedBy], references: [id])
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  userId     String
  subtaskId  String?
  subtask    Subtask? @relation("SubtaskActivity", fields: [subtaskId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model DailyReport {
  id          String                @id @default(uuid())
  userId      String
  projectId   String
  dayNumber   Int
  date        DateTime
  location    String
  remarks     String?
  attachments String[]
  createdAt   DateTime              @default(now())
  project     Project               @relation(fields: [projectId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  receivers   DailyReportReceiver[]
}

model DailyReportReceiver {
  reportId String
  userId   String
  read     Boolean     @default(false)
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])

  @@id([reportId, userId])
}

model WeeklyReport {
  id          String                 @id @default(uuid())
  userId      String
  title       String
  dateFrom    DateTime
  dateTo      DateTime
  remarks     String?
  attachments String[]
  createdAt   DateTime               @default(now())
  projectId   String?
  project     Project?               @relation(fields: [projectId], references: [id])
  user        User                   @relation(fields: [userId], references: [id])
  receivers   WeeklyReportReceiver[]

  @@index([projectId])
}

model WeeklyReportReceiver {
  reportId String
  userId   String
  read     Boolean      @default(false)
  report   WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])

  @@id([reportId, userId])
}

model ProjectApproval {
  id         String         @id @default(uuid())
  projectId  String
  level      ApprovalLevel
  order      Int            @default(0)
  isFinal    Boolean        @default(false)
  status     ApprovalStatus @default(PENDING)
  approverId String
  remarks    String?
  actedAt    DateTime?
  createdAt  DateTime       @default(now())
  approver   User           @relation(fields: [approverId], references: [id])
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([approverId])
  @@index([status])
  @@index([level])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model ApprovalAuditLog {
  id             String         @id @default(uuid())
  projectId      String
  approverId     String
  level          ApprovalLevel
  action         String
  previousStatus ProjectStatus?
  newStatus      ProjectStatus?
  remarks        String?
  createdAt      DateTime       @default(now())
  approver       User           @relation("ApprovedBy", fields: [approverId], references: [id])
  project        Project        @relation("ApprovalAudit", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([approverId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectTimeline {
  id        String   @id @default(uuid())
  projectId String
  date      DateTime
  planned   Float
  actual    Float
  variance  Float
  daysAhead Float
  project   Project  @relation(fields: [projectId], references: [id])
}

model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model Region {
  id        String     @id @default(uuid())
  regCode   String     @unique
  regName   String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  provinces Province[]

  @@index([regCode])
}

model Province {
  id        String   @id @default(uuid())
  provCode  String   @unique
  provName  String
  regCode   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
  region    Region   @relation(fields: [regCode], references: [regCode], onDelete: Cascade)

  @@index([regCode])
  @@index([provCode])
}

model City {
  id        String     @id @default(uuid())
  cityCode  String     @unique
  cityName  String
  provCode  String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  barangays Barangay[]
  province  Province   @relation(fields: [provCode], references: [provCode], onDelete: Cascade)

  @@index([provCode])
  @@index([cityCode])
}

model Barangay {
  id        String   @id @default(uuid())
  brgyCode  String   @unique
  brgyName  String
  cityCode  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  city      City     @relation(fields: [cityCode], references: [cityCode], onDelete: Cascade)

  @@index([cityCode])
  @@index([brgyCode])
}

model BusinessUnit {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  entity        String
  buHead        String?
  assistantHead String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([code])
  @@index([entity])
}

enum ProjectStatus {
  DRAFT
  FOR_REVIEW
  FOR_APPROVAL
  ACTIVE
  INACTIVE
  REJECTED
  NEEDS_REVISION
  ARCHIVED
}

enum ApprovalLevel {
  BU_HEAD
  OP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
