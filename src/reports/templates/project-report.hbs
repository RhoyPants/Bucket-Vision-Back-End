<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <style>
    @page { size: A4 portrait; margin: 12mm 10mm 15mm; }
    * { box-sizing: border-box; }
    body { margin: 0; color: #14213d; font: 10px Arial, Helvetica, sans-serif; }
    h1, h2, h3, p { margin: 0; }
    .header { display: grid; grid-template-columns: 1fr 2fr 1fr; align-items: center; padding-bottom: 12px; border-bottom: 3px solid #1574c4; }
    .brand { display: flex; align-items: center; }
    .brand img { display: block; width: 115px; height: auto; object-fit: contain; }
    .title { text-align: center; }
    .title h1 { color: #123f78; font-size: 20px; }
    .title h2 { color: #1478c9; font-size: 13px; margin-top: 5px; }
    .title p { color: #64748b; margin-top: 5px; }
    .meta { text-align: right; font-size: 8px; line-height: 1.55; }
    .meta strong { display: block; color: #123f78; font-size: 9px; }
    .section { margin-top: 14px; break-inside: avoid; }
    .section-title { color: #123f78; font-size: 11px; font-weight: 800; border-bottom: 1px solid #dbe5f1; padding-bottom: 6px; margin-bottom: 8px; }
    .summary { display: grid; grid-template-columns: repeat(5, 1fr); border: 1px solid #dbe5f1; }
    .metric { min-height: 68px; padding: 10px; border-right: 1px solid #dbe5f1; }
    .metric:last-child { border-right: 0; }
    .metric label { display: block; color: #64748b; font-size: 7px; text-transform: uppercase; }
    .metric strong { display: block; color: #123f78; font-size: 16px; margin: 8px 0 4px; }
    .metric .positive { color: #16a34a; }
    .metric .negative { color: #dc2626; }
    .pill { display: inline-block; border-radius: 12px; padding: 4px 8px; background: #e2e8f0; font-size: 8px; font-weight: 800; }
    .pill.HEALTHY { color: #15803d; background: #dcfce7; }
    .pill.AT_RISK { color: #a16207; background: #fef3c7; }
    .pill.DELAYED { color: #b91c1c; background: #fee2e2; }
    .charts { display: grid; grid-template-columns: 2fr 1fr; gap: 12px; }
    .chart { border: 1px solid #dbe5f1; padding: 8px; }
    .chart svg { width: 100%; height: auto; }
    .two-column { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .empty { padding: 12px; border-radius: 6px; background: #eff6ff; color: #1e5f91; }
    .incident { padding: 9px; border: 1px solid #fecaca; margin-bottom: 6px; }
    .incident strong { font-size: 10px; }
    .photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; }
    .photo { min-width: 0; border: 1px solid #dbe5f1; padding: 5px; break-inside: avoid; overflow: hidden; }
    .photo img { display: block; width: 100%; height: 130px; object-fit: cover; background: #eef2f7; }
    .photo-placeholder { display: flex; width: 100%; height: 130px; align-items: center; justify-content: center; background: #eef2f7; color: #64748b; font-size: 8px; }
    .photo p { margin-top: 5px; overflow-wrap: anywhere; word-break: break-word; }
    table { width: 100%; border-collapse: collapse; }
    thead { display: table-header-group; }
    th { background: #eaf3fc; color: #123f78; font-size: 7px; text-align: left; padding: 7px 6px; }
    td { border-bottom: 1px solid #e5eaf0; padding: 6px; vertical-align: top; }
    tr { break-inside: avoid; }
    .number { text-align: right; white-space: nowrap; }
    .scope-row td { background: #eef6ff; color: #123f78; font-weight: 800; }
    .audit-table { font-size: 8px; }
    .audit-table .person { color: #64748b; font-size: 7px; margin-top: 3px; }
    .notes { background: #f8fafc; padding: 10px; color: #475569; line-height: 1.5; }
    .page-break { break-before: page; }
  </style>
</head>
<body>
  <header class="header">
    <div class="brand"><img src="{{logoDataUri}}" alt="Global Visions Holdings"></div>
    <div class="title">
      <h1>PROJECT PROGRESS REPORT</h1>
      <h2>{{project.name}}</h2>
      <p>{{#if project.location.cityName}}{{project.location.cityName}}{{else}}Location not specified{{/if}}</p>
    </div>
    <div class="meta">
      GENERATED BY<strong>{{report.generatedBy.name}}</strong>
      REPORT TYPE<strong>{{reportTitle}}</strong>
      REPORTING PERIOD<strong>{{periodLabel}}</strong>
    </div>
  </header>

  <section class="section">
    <h3 class="section-title">PROJECT SUMMARY</h3>
    <div class="summary">
      <div class="metric"><label>Expected Progress</label><strong>{{percent summary.expectedProgress}}</strong><small>Expected by period end</small></div>
      <div class="metric"><label>Progress Delivered</label><strong class="positive">{{percent summary.periodProgress}}</strong><small>Delivered during period</small></div>
      <div class="metric"><label>Total Progress</label><strong>{{percent summary.totalProjectProgress}}</strong><small>As of {{date report.periodEnd}}</small></div>
      <div class="metric"><label>Variance</label><strong>{{percent summary.variance}}</strong><small>Actual minus planned</small></div>
      <div class="metric"><label>Project Status</label><strong><span class="pill {{summary.health}}">{{upper summary.health}}</span></strong><small>Based on configured thresholds</small></div>
    </div>
  </section>

  <section class="section charts">
    <div><h3 class="section-title">S-CURVE (PLANNED VS ACTUAL)</h3><div class="chart">{{safe sCurveSvg}}</div></div>
    <div><h3 class="section-title">WORK HEALTH DISTRIBUTION</h3><div class="chart">{{safe healthSvg}}</div></div>
  </section>

  <section class="section">
    <h3 class="section-title">INCIDENT REPORT</h3>
    {{#if incidents.length}}
      {{#each incidents}}<div class="incident"><strong>{{incidentNumber}} · {{title}}</strong><p>{{description}}</p><p>{{date dateRaised}} · {{severity}} · {{status}}</p></div>{{/each}}
    {{else}}<div class="empty">No incidents were reported during this reporting period.</div>{{/if}}
  </section>

  <section class="section">
    <h3 class="section-title">PROGRESS PHOTOS</h3>
    {{#if photos.length}}<div class="photos">{{#each photos}}<div class="photo">{{#if embeddedUrl}}<img src="{{embeddedUrl}}" alt="{{caption}}">{{else}}<div class="photo-placeholder">Image unavailable</div>{{/if}}<p><strong>{{caption}}</strong><br>{{date date}} · {{uploadedBy.name}}</p></div>{{/each}}</div>
    {{else}}<div class="empty">No progress photos were uploaded during this period.</div>{{/if}}
  </section>

  <section class="section page-break">
    <h3 class="section-title">PROGRESS LOGS ({{reportTitle}})</h3>
    <table class="audit-table">
      <thead><tr><th>Date / Given by</th><th>Scope / Task / Subtask</th><th class="number">Progress</th><th class="number">Previous</th><th class="number">Cumulative</th><th class="number">Expected</th><th class="number">Variance</th><th>Status</th></tr></thead>
      <tbody>
        {{#each progressAudit.entries}}
        <tr>
          <td>{{date date}}<div class="person">{{submittedBy.name}}</div></td>
          <td><strong>{{scope.name}}</strong><br>{{task.title}}<br>{{subtask.title}}</td>
          <td class="number">{{percent dailyProgress}}</td><td class="number">{{percent previousProgress}}</td><td class="number">{{percent progressAfter}}</td><td class="number">{{percent expectedProgressAfter}}</td><td class="number">{{percent varianceAfter}}</td>
          <td><span class="pill">{{subtaskStatusAfter}}</span></td>
        </tr>
        {{else}}<tr><td colspan="8">No progress entries were submitted during this period.</td></tr>{{/each}}
      </tbody>
    </table>
  </section>

  <section class="section">
    <h3 class="section-title">DETAILED PROGRESS BY SCOPE, TASK &amp; SUBTASK</h3>
    <table>
      <thead><tr><th>Task</th><th>Subtask</th><th class="number">Actual</th><th class="number">Expected</th><th class="number">Variance</th><th class="number">Period</th><th>Health</th></tr></thead>
      <tbody>
      {{#each detailedProgress}}
        <tr class="scope-row"><td colspan="7">{{name}}</td></tr>
        {{#each tasks}}{{#each subtasks}}
        <tr><td>{{../title}}</td><td>{{title}}</td><td class="number">{{percent metrics.actualProgress}}</td><td class="number">{{percent metrics.expectedProgress}}</td><td class="number">{{percent metrics.variance}}</td><td class="number">{{percent metrics.periodProgress}}</td><td><span class="pill {{metrics.health}}">{{upper metrics.health}}</span></td></tr>
        {{/each}}{{/each}}
      {{/each}}
      </tbody>
    </table>
  </section>

  <section class="section notes">
    <strong>CALCULATION NOTES</strong><br>
    Variance is actual progress minus expected progress. Health follows the configured project thresholds.
    Historical actual progress uses the latest cumulative progress logs at or before the report cutoff.
  </section>
</body>
</html>
